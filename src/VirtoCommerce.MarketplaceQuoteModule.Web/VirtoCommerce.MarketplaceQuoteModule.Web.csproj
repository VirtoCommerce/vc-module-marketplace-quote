<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <IsPackable>false</IsPackable>
    <NoWarn>NU1608</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Project is not a test project -->
    <SonarQubeTestProject>false</SonarQubeTestProject>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="vcmp-quote\dist\**" />
    <Content Remove="vcmp-quote\dist\**" />
    <EmbeddedResource Remove="vcmp-quote\dist\**" />
    <None Remove="vcmp-quote\dist\**" />
    <!-- Admin Shell plugin: Vue sources in vue/, built into plugins/admin-shell/ -->
    <Compile Remove="vue\**" />
    <Content Remove="vue\**" />
    <EmbeddedResource Remove="vue\**" />
    <None Remove="vue\**" />
    <Content Remove="plugins\**" />
    <None Remove="plugins\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- NSwag emits repeated request/response plumbing; regenerate these clients instead of refactoring them.
         They stay project items so this project-level setting reaches them. -->
    <None Include="vue\src\api_client\virtocommerce.*.ts" />
    <SonarQubeSetting Include="sonar.cpd.exclusions">
      <Value>**/vue/src/api_client/virtocommerce.*.ts</Value>
    </SonarQubeSetting>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\VirtoCommerce.MarketplaceQuoteModule.Core\VirtoCommerce.MarketplaceQuoteModule.Core.csproj" />
    <ProjectReference Include="..\VirtoCommerce.MarketplaceQuoteModule.Data\VirtoCommerce.MarketplaceQuoteModule.Data.csproj" />
    <ProjectReference Include="..\VirtoCommerce.MarketplaceQuoteModule.Data.MySql\VirtoCommerce.MarketplaceQuoteModule.Data.MySql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.MarketplaceQuoteModule.Data.PostgreSql\VirtoCommerce.MarketplaceQuoteModule.Data.PostgreSql.csproj" />
    <ProjectReference Include="..\VirtoCommerce.MarketplaceQuoteModule.Data.SqlServer\VirtoCommerce.MarketplaceQuoteModule.Data.SqlServer.csproj" />
  </ItemGroup>
  <ItemGroup>
    <QuoteApp Include="vcmp-quote\dist\**" />
    <!-- MF plugin remote produced by `yarn build:modules-bundle` lands at
         <moduleRoot>/plugins/<appId>/ — the platform's manifest endpoint
         (GET /api/apps/<appId>/manifest) discovers remoteEntry.js there. -->
    <PluginRemotes Include="plugins\**" />
  </ItemGroup>
  <Target Name="CopyCustomContentOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="@(QuoteApp)" DestinationFiles="$(PublishDir)\..\%(Identity)" />
    <Copy SourceFiles="@(PluginRemotes)" DestinationFiles="$(PublishDir)\..\plugins\%(RecursiveDir)%(Filename)%(Extension)" />
  </Target>

  <!-- Admin Shell plugin: built from vue/ into plugins/admin-shell/ before publish, so vc-build Compress (locally and in CI)
       packs it. SkipAdminShellPlugin=true leaves it out. -->
  <Target Name="BuildAdminShellPlugin" BeforeTargets="Publish" Condition="'$(SkipAdminShellPlugin)' != 'true' AND Exists('$(MSBuildProjectDirectory)\vue\package.json')">
    <Exec Command="corepack enable" ContinueOnError="true" />
    <Exec Command="yarn install --immutable" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
    <Exec Command="yarn type-check" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
    <Exec Command="yarn build" WorkingDirectory="$(MSBuildProjectDirectory)\vue" />
  </Target>
  <!-- The platform probes {moduleRoot}/plugins/, but publish goes to {moduleRoot}/bin. The files are listed here, after the
       build: listed when the project loads, a clean checkout (no plugins/admin-shell yet) would copy nothing. Only admin-shell:
       plugins/vendor-portal is copied by CopyCustomContentOnPublish above. -->
  <Target Name="CopyAdminShellPluginOnPublish" AfterTargets="Publish" DependsOnTargets="BuildAdminShellPlugin" Condition="'$(SkipAdminShellPlugin)' != 'true'">
    <ItemGroup>
      <AdminShellPlugin Include="$(MSBuildProjectDirectory)\plugins\admin-shell\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(AdminShellPlugin)" DestinationFiles="$(PublishDir)\..\plugins\admin-shell\%(RecursiveDir)%(Filename)%(Extension)" />
  </Target>
</Project>
